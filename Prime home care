                 _blocoCheck(saida, 0, 'Organizei passagem de plantão completa (SBAR)'),
                 _blocoCheck(saida, 1, 'Passei informações presencialmente ao profissional entrante'),
                 _blocoCheck(saida, 2, 'Destacar pendências, medicações e exames'),
                 _blocoCheck(saida, 3, 'Conferi equipamentos, alarmes e materiais'),
                 _blocoCheck(saida, 4, 'Registrei saída e horário no sistema/prontuário'),
                 const SizedBox(height: 20),
                 ElevatedButton.icon(
                   onPressed: () {
                     if (entrada.every((e) => e) && saida.every((e) => e)) {
                       ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('✅ Plantão encerrado! — PRIME HOME CARE')));
                     } else {
                       ScaffoldMessenger.of(context).showSnackBar(const SnackBar(content: Text('⚠️ Há itens pendentes no checklist!')));
