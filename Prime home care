               ]),
             ),
             RodapePrimeHomeCare(),
           ],
         ),
       ),
     );
   }
   Widget _blocoCheck(List<bool> lista, int idx, String texto) {
     return CheckboxListTile(
       title: Text(texto),
       value: lista[idx],
       onChanged: (v) => setState(() => lista[idx] = v ?? false),
       controlAffinity: ListTileControlAffinity.leading,
       activeColor: AppCores.primaria,
     );
   }
 }
