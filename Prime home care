 // ==========================================================
 // 🧠 CONVERSOR DE TERMINOLOGIA TÉCNICA
 // ==========================================================
 class ConversorTerminologia {
   static final Map<String, String> _dicionario = {
     'pressão alta': 'elevação da pressão arterial',
     'pressão baixa': 'hipotensão arterial',
     'coração acelerado': 'taquicardia / frequência cardíaca aumentada',
     'respiração difícil': 'dispneia / desconforto respiratório',
     'febre': 'pirexia / temperatura corporal elevada',
     'confuso': 'alteração do nível de consciência / quadro confusional',
     'sonolento': 'hipersonia / redução do nível de consciência',
     'dor no peito': 'dor precordial',
     'dor na barriga': 'dor em região abdominal',
     'dor de cabeça': 'cefaleia',
     'fraco': 'astenia / redução da força muscular',
     'não quer comer': 'recusa alimentar / hiporexia',
     'diarréia': 'eliminações intestinais líquidas aumentadas',
     'vômito': 'episódios eméticos',
     'pouca urina': 'débito urinário reduzido / oligúria',
     'dei o remédio': 'administrada medicação conforme prescrição',
     'passei soro': 'instituída infusão de solução parenteral',
     'limpei o paciente': 'realizados cuidados de higiene e conforto',
     'troquei curativo': 'realizada troca de cobertura estéril',
     'avisei o médico': 'notificado o profissional médico responsável',
     'chamei o médico': 'solicitada avaliação médica imediata',
     'fiquei olhando': 'instituída monitorização contínua',
     'melhorou': 'quadro em evolução favorável',
     'piorou': 'agravamento do quadro clínico',
     'está bem': 'quadro clínico estável',
     'soro passando': 'solução parenteral em infusão contínua',
     'sonda funcionando': 'sonda permeável, sem intercorrências, débito preservado',
     'dreno saindo': 'dreno funcional, com débito presente e aspecto preservado',
   };
   static String converter(String textoEntrada) {
     if (textoEntrada.trim().isEmpty) return '';
     String texto = textoEntrada.toLowerCase();
     _dicionario.forEach((simples, tecnico) {
       texto = texto.replaceAll(simples, tecnico);
     });
     texto = texto
         .replaceAll('acho que ', '')
         .replaceAll('parece que ', '')
         .replaceAll('mais ou menos ', 'aproximadamente ')
         .replaceAll('muito ', 'acentuada ')
         .replaceAll('pouco ', 'levemente ');
     if (texto.isNotEmpty) texto = texto[0].toUpperCase() + texto.substring(1);
     if (!texto.endsWith('.')) texto += '.';
     texto += ' Constata-se necessidade de manutenção da monitorização e registros.';
     return texto;
   }
 }
